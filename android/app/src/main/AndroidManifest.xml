<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for release builds to reach the Matrix homeserver (Flutter only
         adds it to the debug/profile manifests). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- G72: the background round notifies about others' changes (local
         notifications via flutter_local_notifications, no push / Firebase).
         Android 13+ asks for it at runtime (first shared group / the
         settings switch). (G31 removed workmanager's copy — the app still
         uses no expedited / foreground workers.) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- G32: no Android auto-backup / device transfer. The app data holds the
         ledger databases and the Matrix session incl. its crypto keys; a
         restore onto a new phone would resurrect a stale crypto identity.
         android:allowBackup covers Android <= 11, fullBackupContent="false"
         the legacy full-backup path, dataExtractionRules Android 12+.
         test/android_manifest_test.dart pins this. -->
    <application
        android:label="MoneyLedger"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- SSO callback deep link: moneyledger://sso-callback?loginToken=... -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="moneyledger" android:host="sso-callback"/>
            </intent-filter>
            <!-- G52 step 7: invite links of link groups. The app form
                 moneyledger://join#v=1&k=…&n=… (the landing page's button) … -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="moneyledger" android:host="join"/>
            </intent-filter>
            <!-- … and the shared https form as a verified App Link (assetlinks.json
                 at https://leostumpf.github.io/.well-known/, G52 step 11). The
                 secret is in the #fragment, which never reaches the server. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                    android:host="leostumpf.github.io"
                    android:pathPrefix="/moneyledger/join"/>
            </intent-filter>
            <!-- G52 step 7: deep links are read by app_links only (SSO callback,
                 invite links); Flutter's own deep linking would also push the
                 link's path as a route. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
        </activity>
        <!-- G78: image_picker (receipt photos) declares a disabled service
             that only asks Google Play services to install the backported
             photo picker. We don't use the backport (Android 13+ has the
             system photo picker, older versions the file chooser) and keep
             the merged manifest free of Google services (F-Droid, G44).
             No CAMERA permission either: the photo is taken by the camera
             app via an intent. test/core/android_manifest_test.dart pins
             both. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            tools:node="remove"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So url_launcher can open the SSO page in a browser (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
    G32: Android 12+ reads this instead of android:allowBackup for cloud backup
    and device-to-device transfer. Both are refused: the app data holds the
    per-account ledger databases and the Matrix session including the Olm /
    Megolm crypto keys. Restoring those onto another phone would resurrect a
    stale crypto identity (broken encrypted sessions) and PRIVACY.md promises
    the ledger stays on the device. A new device recovers the ledger from the
    user's other devices / group members (resync), or from a CSV export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

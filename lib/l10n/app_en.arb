  "welcomeIntroTitle": "Share expenses, fairly",
  "@welcomeIntroTitle": {
    "description": "G39 welcome page 1 title"
  },
  "welcomeIntroBody": "MoneyLedger keeps track of who paid what in a group — a trip, a shared flat, a dinner — and shows who owes whom, like Splitwise or Tricount. Split equally or unevenly, record payments, settle up.",
  "@welcomeIntroBody": {
    "description": "G39 welcome page 1 body"
  },
  "welcomeOpenTitle": "Free, open source, no server",
  "@welcomeOpenTitle": {
    "description": "G39 welcome page 2 title"
  },
  "welcomeOpenBody": "MoneyLedger is free software (AGPL-3.0-or-later) — anyone can read its source code. There is no MoneyLedger server and no MoneyLedger account: your groups and expenses are stored only on your devices.",
  "@welcomeOpenBody": {
    "description": "G39 welcome page 2 body"
  },
  "welcomeSourceLink": "View the source code",
  "@welcomeSourceLink": {
    "description": "G39 welcome: link to the public repository"
  },
  "welcomeMatrixTitle": "What is Matrix?",
  "@welcomeMatrixTitle": {
    "description": "G39 welcome page 3 title; also the login page link"
  },
  "welcomeMatrixBody": "Matrix is an open, decentralized messaging network. Like with e-mail, you choose a provider (a \"homeserver\", e.g. matrix.org) and create a free account there. MoneyLedger uses your Matrix account as your identity and as an end-to-end-encrypted relay to the other members of your groups — that is why you sign in.",
  "@welcomeMatrixBody": {
    "description": "G39 welcome page 3 body"
  },
  "welcomePrivacyTitle": "Who sees what",
  "@welcomePrivacyTitle": {
    "description": "G39 welcome page 4 title"
  },
  "welcomePrivacyMembers": "The members of a group get that group's expenses and payments on their devices — end-to-end encrypted.",
  "@welcomePrivacyMembers": {
    "description": "G39 welcome page 4, point 1"
  },
  "welcomePrivacyServer": "Homeservers only relay encrypted messages: they see which accounts exchange them and when, never the content, and keep nothing once it is delivered.",
  "@welcomePrivacyServer": {
    "description": "G39 welcome page 4, point 2"
  },
  "welcomePrivacyNothingElse": "Nothing else: no MoneyLedger server, no tracking, no ads.",
  "@welcomePrivacyNothingElse": {
    "description": "G39 welcome page 4, point 3"
  },
